{
  "name": "markcopy",
  "displayName": "MarkCopy: Rich Markdown & PDF Preview",
  "description": "One-stop Markdown and PDF preview with right-click copy: rich text, per-element (code / table / diagram), raw Markdown, CSV/TSV, and PNG.",
  "version": "0.0.1",
  "publisher": "okstudio",
  "license": "MIT",
  "author": "OK Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenpkent/markcopy.git"
  },
  "bugs": {
    "url": "https://github.com/owenpkent/markcopy/issues"
  },
  "homepage": "https://github.com/owenpkent/markcopy#readme",
  "qna": "https://github.com/owenpkent/markcopy/discussions",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "pdf viewer",
    "preview",
    "copy",
    "rich text",
    "clipboard",
    "html",
    "mermaid"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "markcopy.openPreview",
        "title": "MarkCopy: Open Rich Preview to the Side",
        "category": "MarkCopy",
        "icon": "$(open-preview)"
      },
      {
        "command": "markcopy.copyDocumentAsRichText",
        "title": "MarkCopy: Copy Whole Document as Rich Text",
        "category": "MarkCopy"
      }
    ],
    "customEditors": [
      {
        "viewType": "markcopy.pdfPreview",
        "displayName": "MarkCopy PDF Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markcopy.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markcopy.openPreview",
          "when": "editorLangId == markdown",
          "group": "1_markcopy"
        },
        {
          "command": "markcopy.copyDocumentAsRichText",
          "when": "editorLangId == markdown",
          "group": "1_markcopy"
        }
      ],
      "explorer/context": [
        {
          "command": "markcopy.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MarkCopy",
      "properties": {
        "markcopy.styleProfile": {
          "type": "string",
          "enum": [
            "github",
            "vscode"
          ],
          "default": "github",
          "description": "Rendering style. 'github' matches GitHub markdown (best for pasting into docs/email); 'vscode' follows the editor theme."
        },
        "markcopy.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "Keep the preview scroll position in sync with the editor."
        },
        "markcopy.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme.",
            "Always use the light (GitHub) palette.",
            "Always use the dark (GitHub) palette."
          ],
          "default": "auto",
          "description": "Preview color palette. 'auto' follows your VS Code theme; 'light' and 'dark' force a palette. Copied rich text stays light either way."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot": "node scripts/make-screenshot.js",
    "build:ext": "node esbuild.js",
    "build:web": "node esbuild.web.js",
    "compile": "npm run check-types && npm run build:ext && npm run build:web",
    "watch:ext": "node esbuild.js --watch",
    "watch:web": "node esbuild.web.js --watch",
    "watch": "npm-run-all -p watch:*",
    "package": "npm run check-types && node esbuild.js --production && node esbuild.web.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "html-to-image": "^1.11.11",
    "mermaid": "^11.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0"
  }
}
