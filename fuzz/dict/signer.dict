# Tokens for the signer target (fuzz/targets/signer.fuzz.ts): the DER and length-prefixed walkers.

# DER tags and long-form lengths
kw1="\x30\x82"
kw2="\x30\x81"
kw3="\xa0\x82"
kw4="\x31\x82"
kw5="\x04\x82"
kw6="\x30\x80"
kw7="\x00\x00"

# object identifiers: names, algorithms, keys, SignedData, indirect data
kw8="\x06\x03U\x04\x03"
kw9="\x06\x03U\x04\x0a"
kw10="\x2a\x86\x48\x86\xf7\x0d\x01\x07\x02"
kw11="\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b"
kw12="\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01"
kw13="\x2a\x86\x48\xce\x3d\x02\x01"
kw14="\x2a\x86\x48\xce\x3d\x03\x01\x07"
kw15="\x2b\x06\x01\x04\x01\x82\x37\x02\x01\x04"
kw16="\x60\x86\x48\x01\x65\x03\x04\x02\x01"
kw17="\x2b\x0e\x03\x02\x1a"

# times and strings
kw18="\x17\x0d230615000000Z"
kw19="\x18\x0f20230615000000Z"
kw20="\x13"
kw21="\x0c"
kw22="\x1e"

# APK signing block: algorithm ids and the SDK range (little-endian)
kw23="\x01\x01\x00\x00"
kw24="\x03\x01\x00\x00"
kw25="\x01\x02\x00\x00"
kw26="\x21\x04\x00\x00"
kw27="\x18\x00\x00\x00"
kw28="\xff\xff\xff\x7f"
