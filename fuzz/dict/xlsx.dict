# libFuzzer dictionary for the xlsx target (src/xlsx/*: workbook.ts, sheet.ts,
# styles.ts, render.ts over src/ooxml). The input is a zip, so zip structure
# tokens come first, then the XML the workbook reader looks for.
local_header="PK\x03\x04"
central_header="PK\x01\x02"
eocd="PK\x05\x06"
ct="[Content_Types].xml"
rels_root="_rels/.rels"
xl_workbook="xl/workbook.xml"
xl_wbrels="xl/_rels/workbook.xml.rels"
xl_sheet="xl/worksheets/sheet1.xml"
xl_sst="xl/sharedStrings.xml"
xl_styles="xl/styles.xml"
# workbook.ts: relationship types matched by suffix (/officeDocument, /sharedStrings, /styles).
rel_office="/officeDocument"
rel_sst="/sharedStrings"
rel_styles="/styles"
rel_sheet="/worksheet"
rel="<Relationship "
rel_id="Id=\"rId1\""
rel_target="Target=\""
rel_type="Type=\""
rel_external="TargetMode=\"External\""
ns_main="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
ns_r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
# workbook.ts: workbookPr date1904, sheet name/state/r:id.
workbookPr="<workbookPr date1904=\"1\"/>"
date1904="date1904"
sheet="<sheet "
sheet_name="name=\"Sheet1\""
sheet_rid="r:id=\"rId1\""
state_hidden="state=\"hidden\""
state_very="state=\"veryHidden\""
# sheet.ts: rows, cells, types, formulas, columns, merges.
sheetData="<sheetData>"
row="<row r=\"1\">"
cell="<c r=\"A1\""
cell_t_s="t=\"s\""
cell_t_str="t=\"str\""
cell_t_inline="t=\"inlineStr\""
cell_t_b="t=\"b\""
cell_t_e="t=\"e\""
cell_t_n="t=\"n\""
cell_s="s=\"1\""
v="<v>"
v_close="</v>"
f="<f>"
is="<is><t>"
cols="<col min=\"1\" max=\"3\" width=\"12\"/>"
merge="<mergeCell ref=\"A1:B2\"/>"
ref_big="ref=\"A1:XFD1048576\""
# sharedStrings: si, t, rPh and phoneticPr are skipped as phonetic runs.
si="<si><t>"
t_space="<t xml:space=\"preserve\">"
rph="<rPh "
phonetic="<phoneticPr "
# styles.ts: numFmts and cellXfs drive date and number formatting.
numFmt="<numFmt numFmtId=\"164\" formatCode=\""
cellXfs="<cellXfs count=\"1\">"
xf="<xf numFmtId=\"14\"/>"
fmt_general="General"
fmt_date="mm-dd-yy"
fmt_time="h:mm:ss"
fmt_mmss="mm:ss"
val_true="TRUE"
val_false="FALSE"
cdata_close="]]>"
