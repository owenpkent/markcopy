# libFuzzer dictionary for the pptx target (src/pptx/read/* over src/ooxml).
# The input is a zip: container tokens, then the DrawingML and PresentationML
# element and attribute names the deck reader looks up.
local_header="PK\x03\x04"
central_header="PK\x01\x02"
eocd="PK\x05\x06"
ct="[Content_Types].xml"
rels_root="_rels/.rels"
ppt_pres="ppt/presentation.xml"
ppt_rels="ppt/_rels/presentation.xml.rels"
ppt_slide="ppt/slides/slide1.xml"
ppt_layout="ppt/slideLayouts/slideLayout1.xml"
ppt_master="ppt/slideMasters/slideMaster1.xml"
ppt_theme="ppt/theme/theme1.xml"
# deck.ts: slide list, size, relationship types and targets.
sldIdLst="<p:sldIdLst>"
sldId="<p:sldId id=\"256\" r:id=\"rId2\"/>"
sldSz="<p:sldSz cx=\"9144000\" cy=\"6858000\"/>"
rel="<Relationship "
rel_id="Id=\"rId1\""
rel_target="Target=\""
rel_type="Type=\""
rel_external="TargetMode=\"External\""
rel_image="/image"
rel_chart="/chart"
rel_diagram="/diagram"
rel_video="/video"
rel_audio="/audio"
rel_layout="/slideLayout"
rel_master="/slideMaster"
rel_theme="/theme"
# Slide tree: shapes, groups, pictures, tables, text bodies.
spTree="<p:spTree>"
sp="<p:sp>"
grpSp="<p:grpSp>"
grpSpPr="<p:grpSpPr>"
chOff="<a:chOff x=\"0\" y=\"0\"/>"
chExt="<a:chExt cx=\"1\" cy=\"1\"/>"
pic="<p:pic>"
graphicFrame="<p:graphicFrame>"
graphicData="<a:graphicData uri=\""
tbl="<a:tbl>"
tblGrid="<a:tblGrid>"
gridCol="<a:gridCol w=\"1\"/>"
tr="<a:tr h=\"1\">"
tc="<a:tc>"
gridSpan="gridSpan=\"2\""
rowSpan="rowSpan=\"2\""
hMerge="hMerge=\"1\""
vMerge="vMerge=\"1\""
txBody="<p:txBody>"
xfrm="<a:xfrm rot=\"5400000\" flipH=\"1\" flipV=\"1\">"
off="<a:off x=\"0\" y=\"0\"/>"
ext="<a:ext cx=\"1\" cy=\"1\"/>"
ph="<p:ph type=\"title\" idx=\"1\"/>"
ph_ctr="ctrTitle"
ph_body="type=\"body\""
blip="<a:blip r:embed=\"rId1\"/>"
embed="r:embed=\""
cNvPr="<p:cNvPr id=\"1\" name=\"x\" descr=\"d\"/>"
# Paragraphs, runs, bullets, alignment, fields, line breaks.
pPr="<a:pPr lvl=\"1\" algn=\"ctr\">"
algn_just="algn=\"just\""
algn_dist="algn=\"thaiDist\""
buChar="<a:buChar char=\"x\"/>"
buAutoNum="<a:buAutoNum type=\"arabicPeriod\"/>"
buNone="<a:buNone/>"
rPr="<a:rPr sz=\"1800\" b=\"1\" i=\"1\" u=\"sng\">"
fld="<a:fld id=\"{0}\" type=\"slidenum\">"
br="<a:br/>"
# Colours and theme: scheme and sRGB values, modifiers.
srgbClr="<a:srgbClr val=\"FFFFFF\"/>"
schemeClr="<a:schemeClr val=\"accent1\"/>"
sysClr="<a:sysClr val=\"windowText\" lastClr=\"000000\"/>"
lumMod="<a:lumMod val=\"50000\"/>"
lumOff="<a:lumOff val=\"50000\"/>"
tint="<a:tint val=\"50000\"/>"
shade="<a:shade val=\"50000\"/>"
clrMap="<p:clrMap bg1=\"lt1\" tx1=\"dk1\"/>"
clrScheme="<a:clrScheme name=\"x\">"
bg2="bg2"
hlink="hlink"
folHlink="folHlink"
txStyles="<p:txStyles>"
titleStyle="<p:titleStyle>"
bodyStyle="<p:bodyStyle>"
otherStyle="<p:otherStyle>"
defaultTextStyle="<p:defaultTextStyle>"
lstStyle="<a:lstStyle>"
solidFill="<a:solidFill>"
ns_pres="http://schemas.openxmlformats.org/presentationml/2006/main"
ns_a="http://schemas.openxmlformats.org/drawingml/2006/main"
ns_r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
