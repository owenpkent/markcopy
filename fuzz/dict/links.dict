# libFuzzer dictionary for the links target (classifyLink in src/preview-utils.ts;
# hostFollowsLink, refFromHref, refFromText, markdownLink in src/webview/links.ts).
# The property: nothing the host follows as external may be read by a browser as
# javascript:, data:, file: or another non-http(s)/mailto scheme.
http="http://"
https="https://"
mailto="mailto:"
mailto_query="mailto:a@b.co?subject=x"
protocol_relative="//"
protocol_relative_host="//example.com/"
javascript="javascript:"
javascript_mixed="JaVaScRiPt:"
javascript_alert="javascript:alert(1)"
data_html="data:text/html,"
data_b64="data:text/html;base64,"
blob="blob:"
file="file:///"
file_win="file:///C:/"
vbscript="vbscript:"
vscode="vscode://"
vscode_file="vscode://file/"
ftp="ftp://"
tel="tel:"
ws="ws://"
chrome="chrome://"
about="about:blank"
# hostFollowsLink and classifyLink read /^[a-z][a-z0-9+.-]+:/i: a scheme needs
# two or more characters, so drive letters and single letters are local paths.
drive_c="C:\\"
drive_c_slash="C:/"
one_letter="a:"
plus_scheme="a+b:"
dot_scheme="a.b:"
dash_scheme="a-b:"
digit_first="1a:"
# Characters a browser strips or tolerates before or inside a scheme
# (tab, newline, CR, leading C0 controls and spaces).
tab_in_scheme="java\x09script:"
lf_in_scheme="java\x0ascript:"
cr_in_scheme="java\x0dscript:"
leading_space=" javascript:"
leading_ctrl="\x01javascript:"
leading_nbsp="\xc2\xa0javascript:"
nul="\x00"
fullwidth_colon="javascript\xef\xbc\x9a"
html_colon="javascript&colon;"
# classifyLink: fragments, query and fragment splitting, local paths, percent decoding.
fragment="#"
fragment_frag="#section"
query="?"
query_frag="?a=b#c"
dotdot="../"
dot="./"
root="/"
backslash="\\"
unc="\\\\host\\share"
pct_slash="%2F"
pct_bad="%"
pct_bad2="%zz"
pct_00="%00"
pct_colon="%3A"
md_ext=".md"
markdown_ext=".markdown"
mdx_ext=".mdx"
csv_ext=".csv"
tsv_ext=".tsv"
# refFromText: emails, bare hosts, trailing punctuation. markdownLink: [] escapes
# and ( ) whitespace encoding, which the target checks.
email="a@b.co"
email_dot="a@b.co."
www="www."
bare_host="example.com"
trailing=".,;:!?"
paren_open="("
paren_close=")"
bracket_open="["
bracket_close="]"
md_link="]("
space=" "
