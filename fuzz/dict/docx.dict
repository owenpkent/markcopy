# libFuzzer dictionary for the docx target (src/docx/read/* over src/ooxml).
# The input is a zip: container tokens, then the WordprocessingML, DrawingML and
# OMML names the reader handles (src/docx/read/index.ts, inline.ts, math).
local_header="PK\x03\x04"
central_header="PK\x01\x02"
eocd="PK\x05\x06"
ct="[Content_Types].xml"
rels_root="_rels/.rels"
word_doc="word/document.xml"
word_rels="word/_rels/document.xml.rels"
word_styles="word/styles.xml"
word_numbering="word/numbering.xml"
word_footnotes="word/footnotes.xml"
word_endnotes="word/endnotes.xml"
word_comments="word/comments.xml"
rel="<Relationship "
rel_id="Id=\"rId1\""
rel_target="Target=\""
rel_type="Type=\""
rel_external="TargetMode=\"External\""
rel_hyperlink="/hyperlink"
rel_image="/image"
rel_footnotes="/footnotes"
rel_endnotes="/endnotes"
rel_comments="/comments"
rel_numbering="/numbering"
rel_chart="/chart"
ns_w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
ns_m="http://schemas.openxmlformats.org/officeDocument/2006/math"
# Body structure: paragraphs, runs, tables, sections, structured tags.
body="<w:body>"
p_open="<w:p>"
pPr="<w:pPr>"
pStyle="<w:pStyle w:val=\"Heading1\"/>"
outlineLvl="<w:outlineLvl w:val=\"0\"/>"
r_open="<w:r>"
rPr="<w:rPr>"
t_open="<w:t xml:space=\"preserve\">"
instrText="<w:instrText>"
fldChar_begin="<w:fldChar w:fldCharType=\"begin\"/>"
fldChar_sep="w:fldCharType=\"separate\""
fldChar_end="w:fldCharType=\"end\""
fldSimple="<w:fldSimple w:instr=\"HYPERLINK\">"
tab="<w:tab/>"
br="<w:br/>"
br_page="w:type=\"page\""
noBreakHyphen="<w:noBreakHyphen/>"
sym="<w:sym w:char=\"F0A7\"/>"
tbl="<w:tbl>"
tr="<w:tr>"
tc="<w:tc>"
tcPr="<w:tcPr>"
gridSpan="<w:gridSpan w:val=\"2\"/>"
vMerge="<w:vMerge w:val=\"restart\"/>"
gridBefore="<w:gridBefore w:val=\"1\"/>"
tblHeader="<w:tblHeader/>"
sdt="<w:sdt><w:sdtContent>"
smartTag="<w:smartTag>"
customXml="<w:customXml>"
bookmarkStart="<w:bookmarkStart w:id=\"0\" w:name=\"x\"/>"
sectPr="<w:sectPr>"
# Formatting flags: bold, italic, strike, vertical alignment, highlight, hidden.
b="<w:b/>"
i="<w:i/>"
strike="<w:strike/>"
dstrike="<w:dstrike/>"
vertAlign="<w:vertAlign w:val=\"superscript\"/>"
highlight="<w:highlight w:val=\"yellow\"/>"
vanish="<w:vanish/>"
rFonts="<w:rFonts w:ascii=\"Courier New\"/>"
jc="<w:jc w:val=\"center\"/>"
# Lists: numPr, numbering definitions and overrides.
numPr="<w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"1\"/></w:numPr>"
abstractNum="<w:abstractNum w:abstractNumId=\"0\">"
numFmt_bullet="<w:numFmt w:val=\"bullet\"/>"
numFmt_decimal="w:val=\"decimal\""
lvlOverride="<w:lvlOverride w:ilvl=\"0\">"
startOverride="<w:startOverride w:val=\"1\"/>"
basedOn="<w:basedOn w:val=\"Normal\"/>"
# Notes, comments, revisions, hyperlinks, drawings.
fnRef="<w:footnoteReference w:id=\"1\"/>"
enRef="<w:endnoteReference w:id=\"1\"/>"
commentRef="<w:commentReference w:id=\"0\"/>"
commentRangeStart="<w:commentRangeStart w:id=\"0\"/>"
ins="<w:ins w:id=\"1\" w:author=\"a\">"
del="<w:del w:id=\"2\" w:author=\"a\">"
moveTo="<w:moveTo "
hyperlink="<w:hyperlink r:id=\"rId1\" w:anchor=\"x\">"
drawing="<w:drawing><wp:inline>"
anchor="<wp:anchor>"
extent="<wp:extent cx=\"1\" cy=\"1\"/>"
docPr="<wp:docPr id=\"1\" name=\"x\" descr=\"d\"/>"
blip="<a:blip r:embed=\"rId1\"/>"
pict="<w:pict><v:imagedata r:id=\"rId1\"/>"
txbx="<w:txbxContent>"
altContent="<mc:AlternateContent><mc:Choice><mc:Fallback>"
# Charts embedded in a document (chart type, series, caches).
c_pie="<c:pieChart>"
c_bar="<c:barChart>"
c_scatter="<c:scatterChart>"
c_ser="<c:ser>"
c_numCache="<c:numCache><c:formatCode>"
c_strCache="<c:strCache><c:ptCount val=\"1\"/>"
c_pt="<c:pt idx=\"0\"><c:v>"
c_multi="<c:multiLvlStrRef>"
# OMML: math runs, fractions, radicals, n-ary operators, accents, matrices.
oMathPara="<m:oMathPara><m:oMath>"
m_f="<m:f><m:num>"
m_den="<m:den>"
m_rad="<m:rad><m:deg>"
m_nary="<m:nary><m:naryPr><m:chr m:val=\"x\"/>"
m_sSup="<m:sSup>"
m_sSub="<m:sSub>"
m_sSubSup="<m:sSubSup>"
m_acc="<m:acc><m:accPr>"
m_d="<m:d><m:dPr><m:begChr m:val=\"(\"/>"
m_eqArr="<m:eqArr>"
m_matrix="<m:m><m:mr>"
m_func="<m:func><m:fName>"
m_limLow="<m:limLow>"
m_groupChr="<m:groupChr>"
m_borderBox="<m:borderBox>"
m_sty="<m:sty m:val=\"p\"/>"
fn_sin="sin"
fn_log="log"
