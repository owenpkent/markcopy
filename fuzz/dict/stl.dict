# libFuzzer dictionary for the stl target (src/webview/stlInfo.ts: sniffStl,
# checkStl, toBytes). looksAscii wants lowercase "solid" at offsets 0..4; the
# binary format is an 80-byte header, a uint32 triangle count, then 50-byte
# triangles. toBytes also accepts a string or the JSON forms of a Buffer.
solid="solid"
solid_name="solid x\x0a"
solid_facet="solid\x0afacet"
solid_upper="SOLID"
solid_sp=" solid"
solid_off4="    solid"
facet="facet normal "
facet_line="facet normal 0 0 1\x0a"
outer="outer loop\x0a"
vertex="vertex "
vertex_line="vertex 0 0 0\x0a"
endloop="endloop\x0a"
endfacet="endfacet\x0a"
endsolid="endsolid"
endsolid_name="endsolid x"
space=" "
newline="\x0a"
crlf="\x0d\x0a"
tab="\x09"
num_zero="0"
num_neg="-1.5e+3"
num_exp="1e999"
nan="nan"
inf="inf"
# Binary triangle count field (little-endian): zero, one, and huge values the
# checkStl size and triangle-limit tests react to.
count_zero="\x00\x00\x00\x00"
count_one="\x01\x00\x00\x00"
count_big="\xff\xff\xff\xff"
count_mid="\x00\x00\x10\x00"
attr_bytes="\x00\x00"
float_one="\x00\x00\x80\x3f"
float_nan="\x00\x00\xc0\x7f"
float_inf="\x00\x00\x80\x7f"
header_pad="\x00\x00\x00\x00\x00\x00\x00\x00"
# toBytes JSON shapes (src/webview/stlInfo.ts lines ~91 and 98): Node Buffer
# JSON and an array-like object with a length.
json_buffer="{\"type\":\"Buffer\",\"data\":["
json_length="{\"length\":"
json_zero_key="\"0\":"
json_type="\"type\":"
json_data="\"data\":"
json_array="[0,255,256,-1]"
json_empty="{}"
json_null="null"
