# Tokens for the pe target (fuzz/targets/pe.fuzz.ts): what readPe and its
# resource, version, manifest, icon, CLR and signature readers branch on.
# Version-resource keys are UTF-16LE, as Windows writes them. The prototype
# names are here because a file naming one once reached a lookup table
# (docs/FUZZING-STRATEGY.md).

# headers and sections
kw1="MZ"
kw2="PE\x00\x00"
kw3="\x0b\x01"
kw4="\x0b\x02"
