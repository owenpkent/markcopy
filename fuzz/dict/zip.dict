# libFuzzer dictionary for the zip target (src/ooxml/zip.ts, fflate unzipSync).
# Record signatures: fflate walks the end-of-central-directory, central
# directory and local headers by these.
local_header="PK\x03\x04"
central_header="PK\x01\x02"
eocd="PK\x05\x06"
zip64_eocd="PK\x06\x06"
zip64_locator="PK\x06\x07"
data_descriptor="PK\x07\x08"
magic="PK"
# openZip rejects anything not starting 0x50 0x4b, then limits entry and total sizes.
method_stored="\x00\x00"
method_deflate="\x08\x00"
version_20="\x14\x00"
version_45="\x2d\x00"
flag_utf8="\x00\x08"
flag_descriptor="\x08\x00"
size_max="\xff\xff\xff\xff"
size_zero="\x00\x00\x00\x00"
size_16="\xff\xff"
zip64_extra="\x01\x00\x10\x00"
utf8_path_extra="up"
# Entry names the readers look up, and the traversal shapes openZip normalises
# (backslashes, "..", absolute paths, directory entries).
ct="[Content_Types].xml"
rels_root="_rels/.rels"
rels_ext=".rels"
xl_workbook="xl/workbook.xml"
xl_wbrels="xl/_rels/workbook.xml.rels"
xl_sheet="xl/worksheets/sheet1.xml"
xl_sst="xl/sharedStrings.xml"
xl_styles="xl/styles.xml"
ppt_pres="ppt/presentation.xml"
ppt_slide="ppt/slides/slide1.xml"
word_doc="word/document.xml"
word_rels="word/_rels/document.xml.rels"
dotdot="../"
dotdot_win="..\\"
backslash="\\"
slash="/"
abs_root="/xl/"
macosx="__MACOSX/"
dir_entry="xl/"
