# libFuzzer dictionary for the review target (src/videoReview.ts loadSidecar and
# addNoteText over the YAML sidecar of src/review/schema.ts, the okstudio-video-kit
# review schema: additionalProperties false, so unknown keys are rejected).
version="version: 1\x0a"
version_key="version:"
id_key="id:"
source="source: clip.mp4\x0a"
fps="fps: 29.97\x0a"
fps_int="fps: 30\x0a"
next_note_id="next_note_id: 1\x0a"
asset="asset:\x0a"
rating="  rating: 3\x0a"
status="  status: needs_review\x0a"
status_none="none"
status_progress="in_progress"
status_approved="approved"
status_rejected="rejected"
keywords="  keywords: [a, b]\x0a"
asset_notes="  notes: x\x0a"
notes="notes:\x0a"
notes_empty="notes: []\x0a"
item="  - id: n1\x0a"
dash="- "
target_source="    target: source\x0a"
target_render="    target: render\x0a"
at="    at: 1.5\x0a"
out="    out: 2.5\x0a"
kind_note="    kind: note\x0a"
kind_keep="kind: keep"
kind_reject="kind: reject"
text="    text: hello\x0a"
color="    color: \"#ff0000\"\x0a"
author="    author: me\x0a"
point="    point: [0.5, 0.5]\x0a"
done="    done: false\x0a"
done_true="done: true"
applied_op="    applied_op: null\x0a"
checkpoint="    checkpoint: null\x0a"
drawing="    drawing:\x0a"
tool_arrow="tool: arrow"
tool_line="tool: line"
tool_box="tool: box"
tool_free="tool: free"
points="points: [[0, 0], [1, 1]]"
created="    created: 2026-01-01T00:00:00\x0a"
# YAML shapes that change how the parser reads a value.
doc_start="---\x0a"
doc_end="...\x0a"
flow_map="{a: 1}"
flow_seq="[1, 2]"
block_scalar_lit="|\x0a  x\x0a"
block_scalar_fold=">\x0a  x\x0a"
anchor="&a "
alias="*a"
tag="!!str "
null_tilde="~"
true_val="true"
false_val="false"
nan=".nan"
inf=".inf"
colon_space=": "
quoted="\"x\""
single_quoted="'x'"
crlf="\x0d\x0a"
bom="\xef\xbb\xbf"
tab="\x09"
merge_key="<<: *a"
