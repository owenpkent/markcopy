# libFuzzer dictionary for the markdown-html target: markdown-it render (html:
# true) followed by DOMPurify defaults, then a check that no <script>, on*
# attribute or javascript:/vbscript: URL survives. Tokens aim at the sanitizer's
# attack surface; Markdown syntax tokens live in markdown.dict.
script="<script>"
script_close="</script>"
script_src="<script src=\"x\"></script>"
img_onerror="<img src=x onerror=alert(1)>"
img_src="<img src=\""
svg="<svg onload=alert(1)>"
svg_use="<svg><use xlink:href=\"#a\"/></svg>"
math="<math><mi>"
iframe="<iframe src=\"javascript:alert(1)\">"
object="<object data=\"x\">"
embed="<embed src=\"x\">"
form="<form action=\"javascript:alert(1)\"><button formaction=\"x\">"
input="<input autofocus onfocus=alert(1)>"
video="<video poster=\"x\"><source src=\"x\">"
audio="<audio src=\"x\">"
a_href="<a href=\""
a_target="<a target=_blank href=\"x\">"
base="<base href=\"x\">"
meta="<meta http-equiv=\"refresh\" content=\"0;url=x\">"
link_tag="<link rel=stylesheet href=\"x\">"
style="<style>"
style_close="</style>"
template="<template>"
noscript="<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\">"
textarea="<textarea>"
title_tag="<title>"
xmp="<xmp>"
plaintext="<plaintext>"
select_option="<select><option>"
table_misnest="<table><td>"
mglyph="<mglyph>"
annotation="<annotation-xml encoding=\"text/html\">"
foreignObject="<foreignObject>"
# Event attributes and URL attributes the check inspects (URL_ATTRS in the target).
onclick=" onclick=\""
onload=" onload="
onerror=" onerror="
onmouseover=" onmouseover="
attr_href=" href="
attr_src=" src="
attr_xlink=" xlink:href="
attr_action=" action="
attr_formaction=" formaction="
attr_data=" data="
attr_poster=" poster="
style_attr=" style=\"background:url(javascript:x)\""
# URL schemes and obfuscation (stripControls in the target removes C0 and C1 controls).
js="javascript:"
js_mixed="JaVaScRiPt:"
js_tab="java\x09script:"
js_nl="java\x0ascript:"
js_entity="&#106;avascript:"
js_entity_hex="&#x6A;avascript:"
js_colon="javascript&colon;"
vbs="vbscript:"
data_html="data:text/html;base64,"
data_svg="data:image/svg+xml,"
mailto="mailto:"
nbsp_ws="\xc2\xa0"
c1_ctrl="\xc2\x80"
nul="\x00"
# Parser-differential openers: comments, CDATA, processing instructions, namespaces.
comment="<!--"
comment_end="-->"
cdata="<![CDATA["
cdata_end="]]>"
pi="<?xml"
doctype="<!DOCTYPE html>"
bogus_comment="<!>"
slash_attr="<a/href=x>"
backtick_attr="<a href=`x`>"
# Markdown that becomes HTML: raw HTML blocks, autolinks, fences and math that
# markdown-it escapes or wraps (mermaid-src placeholder, texmath spans).
md_autolink="<javascript:alert(1)>"
md_link_js="[x](javascript:alert(1))"
md_image_js="![x](javascript:alert(1))"
md_ref_js="[x]: javascript:alert(1)\x0a"
md_fence_mermaid="```mermaid\x0a"
md_math="$$<script>$$"
md_footnote="[^1]: <img src=x onerror=1>"
md_html_block="<div>\x0a\x0a"
