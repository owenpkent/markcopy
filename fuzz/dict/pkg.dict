# Tokens for the pkg target and its pkg-<format> variants
# (fuzz/targets/pkg.fuzz.ts): magics, member and stream names, control fields
# and XML names the package readers branch on. MSI stream names are UTF-16LE
# in the compound file directory. The prototype names are here because a file
# naming one once reached a lookup table (docs/FUZZING-STRATEGY.md).

# magics
kw1="\x7fELF"
kw2="\xed\xab\xee\xdb"
kw3="\x8e\xad\xe8"
kw4="!<arch>\x0a"
kw5="\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1"
kw6="xar!"
kw7="PK\x03\x04"
kw8="PK\x01\x02"
kw9="PK\x05\x06"
kw10="PK\x06\x06"
kw11="\x1f\x8b\x08"
kw12="\xfd7zXZ\x00"
kw13="(\xb5/\xfd"
kw14="P*M\x18"
kw15="x\x9c"
kw16="BZh"
kw17="ustar"
kw18="koly"
kw19="mish"
kw20="encrcdsa"
kw21="cdsaencr"
kw22="\xfa\xde\x0c\xc0"

# Debian and Alpine
kw23="debian-binary"
kw24="control.tar.gz"
kw25="control.tar.xz"
kw26="control.tar.zst"
kw27="data.tar.xz"
kw28="./control"
kw29="Package: "
kw30="Version: "
kw31="Architecture: "
kw32="Depends: "
kw33="Maintainer: "
kw34="Description: "
kw35="preinst"
kw36="postinst"
kw37="md5sums"
kw38="conffiles"
kw39=".PKGINFO"
kw40="pkgname = "
kw41="pkgver = "
kw42="depend = "
kw43=".SIGN.RSA."
kw44=".post-install"
kw45=".pre-install"
kw46="PaxHeader"
kw47="path="

# RPM
kw48="\x00\x00\x03\xe8"
kw49="\x00\x00\x03\xe9"
kw50="\x00\x00\x00>"
kw51="\x8e\xad\xe8\x01"

# Windows Installer
kw52="R\x00o\x00o\x00t\x00 \x00E\x00n\x00t\x00r\x00y\x00"
kw53="\x05S\x00u\x00m\x00m\x00a\x00r\x00y\x00I\x00n\x00f\x00o\x00r\x00m\x00a\x00t\x00i\x00o\x00n\x00"
kw54="ProductName"
kw55="ProductVersion"
kw56="Manufacturer"
kw57="ProductCode"
kw58="UpgradeCode"
kw59="ALLUSERS"
kw60="Intel;1033"
kw61="x64;1033"
kw62="Arm64;1033"
kw63="\x1e\x00\x00\x00"
kw64="\x1f\x00\x00\x00"
kw65="@\x00\x00\x00"

# xar and disk image XML
kw66="<xar>"
kw67="<toc>"
kw68="<file"
kw69="<data>"
kw70="<encoding style=\x22application/x-gzip\x22/>"
kw71="<checksum style=\x22sha1\x22>"
kw72="<signature"
kw73="<pkg-info"
kw74="<installer-gui-script"
kw75="<pkg-ref"
kw76="<bundle"
kw77="auth=\x22root\x22"
kw78="install-location=\x22"
kw79="Distribution"
kw80="PackageInfo"
kw81="Payload"
kw82="Scripts"
kw83="Bom"
kw84="<plist"
kw85="<dict>"
kw86="<key>"
kw87="<array>"
kw88="<data>"
kw89="resource-fork"
kw90="blkx"

# zip-based packages
kw91="META-INF/MANIFEST.MF"
kw92="META-INF/CERT.RSA"
kw93="Main-Class: "
kw94="Created-By: "
kw95="Implementation-Version: "
kw96="extension.vsixmanifest"
kw97="extension/package.json"
kw98="\x22engines\x22"
kw99="\x22activationEvents\x22"
kw100=".dist-info/METADATA"
kw101=".dist-info/WHEEL"
kw102="Requires-Dist: "
kw103="Root-Is-Purelib: "
kw104=".nuspec"
kw105="<metadata>"
kw106="<id>"
kw107="<version>"
kw108="<dependencies>"
kw109="AndroidManifest.xml"
kw110="classes.dex"
kw111="APK Sig Block 42"
kw112="\x03\x00\x08\x00"
kw113="\x01\x00\x1c\x00"
kw114="\x80\x01\x08\x00"

# ELF
kw115=".interp"
kw116=".dynamic"
kw117=".dynstr"
kw118=".note.gnu.build-id"
kw119="GNU"
kw120="libc.so.6"
kw121="/lib64/ld-linux-x86-64.so.2"
kw122="AI\x02"

# prototype names
kw123="constructor"
kw124="__proto__"
kw125="hasOwnProperty"
kw126="toString"
