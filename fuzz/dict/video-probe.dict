# libFuzzer dictionary for the video-probe target (src/videoProxy.ts parseProbe,
# codecLabel, canRemux, silentAudio, audioCodecLabel, parseProgressSeconds).
# The input is split at the first NUL: ffprobe JSON before it, ffmpeg
# -progress text after it.
nul="\x00"
# parseProbe reads format.duration and the first video and audio streams.
streams="{\"streams\":["
streams_empty="{\"streams\":[]}"
format="\"format\":{\"duration\":\""
duration="\"duration\":"
video_type="\"codec_type\":\"video\""
audio_type="\"codec_type\":\"audio\""
width="\"width\":"
height="\"height\":"
r_frame="\"r_frame_rate\":\""
avg_frame="\"avg_frame_rate\":\""
rate_ntsc="30000/1001"
rate_zero="0/0"
rate_slash="/"
pix_fmt="\"pix_fmt\":\""
pix_yuva="yuva420p"
pix_rgba="rgba"
pix_yuv="yuv420p"
pix_alpha_hint="a"
tags="\"tags\":{\"alpha_mode\":\"1\"}"
alpha_mode="alpha_mode"
codec_name="\"codec_name\":\""
profile="\"profile\":\""
null_entry="null"
na="N/A"
# Video codec names in codecLabel, COPYABLE_VIDEO and REMUXABLE_VIDEO.
prores="prores"
profile_4444="4444"
profile_unknown="unknown"
dnxhd="dnxhd"
hevc="hevc"
h264="h264"
vp9="vp9"
av1="av1"
mpeg2="mpeg2video"
mjpeg="mjpeg"
rawvideo="rawvideo"
cineform="cineform"
ffv1="ffv1"
# Audio codec names: PLAYABLE_AUDIO (mp3, flac, vorbis), the labelled ones, and the pcm_ prefix.
aac="aac"
alac="alac"
ac3="ac3"
eac3="eac3"
opus="opus"
mp3="mp3"
flac="flac"
vorbis="vorbis"
pcm_prefix="pcm_"
pcm_s16le="pcm_s16le"
pcm_f32le="pcm_f32le"
# parseProgressSeconds matches /^out_time_(us|ms)=(-?\d+)$/ per line (CRLF allowed).
out_time_us="out_time_us="
out_time_ms="out_time_ms="
out_time_neg="out_time_us=-9223372036854775808"
out_time_na="out_time_us=N/A"
progress="progress=continue\x0a"
progress_end="progress=end\x0a"
frame="frame=1\x0a"
fps="fps=0.00\x0a"
lf="\x0a"
crlf="\x0d\x0a"
# canRemux tests the source name's container (outsideMp4Family).
ext_mkv=".mkv"
ext_webm=".webm"
ext_avi=".avi"
ext_mov=".mov"
ext_mp4=".mp4"
