# libFuzzer dictionary for the markdown target (src/render.ts createMarkdownIt:
# markdown-it with html, linkify and typographer on, plus footnotes, texmath
# (dollars delimiters), anchors, highlight.js fences and the mermaid fence).
h1="# "
h2="## "
h6="###### "
setext_eq="\x0a===\x0a"
setext_dash="\x0a---\x0a"
hr="\x0a***\x0a"
hr_us="\x0a___\x0a"
bullet="- "
star_bullet="* "
ordered="1. "
ordered_paren="1) "
task_open="- [ ] "
task_done="- [x] "
quote="> "
nested_quote="> > "
indent_code="    "
tab_code="\x09"
fence_backtick="```"
fence_tilde="~~~"
fence_mermaid="```mermaid\x0a"
fence_js="```js\x0a"
fence_ts="```typescript\x0a"
fence_py="```python\x0a"
fence_json="```json\x0a"
fence_unknown="```notalanguage\x0a"
bold="**"
bold_us="__"
italic="*"
italic_us="_"
strike="~~"
code_span="`"
code_span_double="``"
# render.ts: footnote reference, definition, inline footnote, footnote tail.
fn_ref="[^1]"
fn_def="[^1]: "
fn_label="[^note]"
fn_inline="^[inline note]"
# texmath with delimiters 'dollars': inline, block, equation numbers.
math_inline="$x$"
math_block="$$\x0a"
math_block_close="\x0a$$"
math_inline_double="$$x$$"
math_eqno="$$x\\tag{1}$$"
math_frac="\\frac{a}{b}"
math_sum="\\sum_{i=0}^{n}"
math_begin="\\begin{aligned}"
math_end="\\end{aligned}"
math_bad_cmd="\\undefinedcmd"
dollar_digit="$5 and $6"
escaped_dollar="\\$"
# Links, images, references, autolinks, linkify.
link="[a](b)"
link_title="[a](b \"t\")"
link_angle="[a](<b c>)"
image="![alt](src.png)"
ref_link="[a][1]"
ref_def="[1]: http://x \"t\"\x0a"
autolink="<http://x.y>"
autolink_mail="<a@b.co>"
linkify_bare="www.example.com"
linkify_fuzzy="github.com/a/b"
# Tables (GFM): header, alignment row, escaped pipe.
table_sep="|---|:---:|---:|\x0a"
table_row="| a | b |\x0a"
table_pipe_escape="\\|"
# Typographer replacements and escapes.
typo_copy="(c)"
typo_tm="(tm)"
typo_ellipsis="..."
typo_dash="---"
typo_quote="\"quoted\""
typo_apos="it's"
backslash_escape="\\*"
hard_break="  \x0a"
entity="&amp;"
entity_num="&#35;"
# html: true, so raw HTML blocks and inline tags pass through (see markdown-html).
html_comment="<!-- x -->"
html_block="<div>\x0a"
html_details="<details><summary>x</summary>"
