# libFuzzer dictionary for the 3mf target (src/webview/threeMf.ts: read3mf).
# A 3MF is a zip of XML: the zip signatures, the part names the reader looks
# for, and the element and attribute names of the model it walks.
pk_local="PK\x03\x04"
pk_central="PK\x01\x02"
pk_end="PK\x05\x06"
rels="_rels/.rels"
root="3D/3dmodel.model"
objects="3D/Objects/"
gcode="Metadata/plate_1.gcode"
slice="Metadata/slice_info.config"
rel_type="http://schemas.microsoft.com/3dmanufacturing/2013/01/3dmodel"
model="<model unit=\"millimeter\">"
resources="<resources>"
build="<build>"
item="<item objectid=\"1\"/>"
object="<object id=\"1\">"
mesh="<mesh>"
vertices="<vertices>"
vertex="<vertex x=\"0\" y=\"0\" z=\"0\"/>"
triangles="<triangles>"
triangle="<triangle v1=\"0\" v2=\"1\" v3=\"2\"/>"
components="<components>"
component="<component objectid=\"1\"/>"
path="p:path=\"/3D/Objects/a.model\""
transform="transform=\"1 0 0 0 1 0 0 0 1 0 0 0\""
base="<basematerials id=\"1\"><base displaycolor=\"#FF0000\"/></basematerials>"
colors="<colorgroup id=\"2\"><color color=\"#00FF00FF\"/></colorgroup>"
pid="pid=\"1\" p1=\"0\""
