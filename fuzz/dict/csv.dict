# libFuzzer dictionary for the csv target (src/csv.ts parseDelimited,
# renderCsvHtml). The first input byte picks the delimiter; the rest is text.
comma=","
semicolon=";"
tab="\x09"
pipe="|"
quote="\""
doubled_quote="\"\""
quote_comma="\",\""
comma_quote=",\""
field_embedded_quote="a\"\"b"
lf="\x0a"
cr="\x0d"
crlf="\x0d\x0a"
lflf="\x0a\x0a"
crcr="\x0d\x0d"
# parseDelimited strips a leading BOM (src/csv.ts line 196) and offsets spans around it.
bom="\xef\xbb\xbf"
quoted_row="\"a\",\"b\"\x0a"
quoted_newline="\"a\x0ab\""
empty_row=",,\x0a"
unterminated="\"abc"
# Number and date sniffing in the renderer (columns right-aligned, header guess).
num_int="123"
num_neg="-1"
num_dec="1.5"
num_exp="1e10"
num_comma="1,000"
num_pct="50%"
nan="NaN"
inf="Infinity"
date="2024-01-01"
# renderCsvHtml escapes HTML in cells and handles formula-looking and link text.
html_lt="<script>"
html_amp="&amp;"
formula="=1+1"
formula_at="@SUM(A1)"
plus="+"
minus="-"
space=" "
nul="\x00"
hdr="id,name\x0a1,a\x0a"
