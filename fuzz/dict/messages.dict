# libFuzzer dictionary for the messages target (the host-side parsers in
# src/messages/*.ts for webview-to-host postMessage payloads). Input is JSON.
obj_open="{\"type\":\""
obj_close="\"}"
type_key="\"type\":"
null="null"
true="true"
false="false"
array="[]"
empty_obj="{}"
proto="\"__proto__\":"
constructor="\"constructor\":"
to_string="\"toString\":"
big_int="9007199254740993"
neg_zero="-0"
exp="1e999"
nan_str="\"NaN\""
# Every message type string the parsers accept.
t_ready="ready"
t_toast="toast"
t_openLink="openLink"
t_openExternal="openExternal"
t_openSettings="openSettings"
t_revealInOS="revealInOS"
